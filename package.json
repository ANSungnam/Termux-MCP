{
  "name": "termux-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server that lets an MCP client drive an Android phone through Termux: shell, files, and termux-api.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YSCodex/termux-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/YSCodex/termux-mcp/issues"
  },
  "homepage": "https://github.com/YSCodex/termux-mcp#readme",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "termux-mcp": "bin/termux-mcp.mjs"
  },
  "main": "src/index.js",
  "files": [
    "bin",
    "src",
    "scripts",
    "install.sh",
    "config.example.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/termux-mcp.mjs --http",
    "start:stdio": "node bin/termux-mcp.mjs --stdio",
    "setup": "bash scripts/setup.sh",
    "test": "node test/smoke.mjs",
    "check": "node scripts/check.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "termux",
    "android",
    "automation",
    "shell",
    "remote"
  ],
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.1",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "express": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0"
  }
}
